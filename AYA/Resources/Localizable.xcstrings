    "cycle.calendar.phase_helper.follicular" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Often a phase when energy begins to rise again and mental clarity can start to feel more available."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genellikle enerjinin yeniden yükselmeye ve zihinsel açıklığın artmaya başladığı bir dönem."
          }
        }
      }
    },
    "cycle.calendar.phase_helper.luteal" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Often associated with slowing down a little, turning inward and making space for your own needs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genellikle biraz daha yavaşlama, içe dönme ve kendi ihtiyaçlarına alan açma isteğiyle ilişkilendirilen bir dönem."
          }
        }
      }
    },
    "cycle.calendar.phase_helper.menstrual" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Often a time when rest, inward focus and listening to your body a little more closely can feel more natural."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genellikle dinlenme, içe dönme ve bedenini biraz daha dikkatle dinleme ihtiyacının arttığı bir dönem."
          }
        }
      }
    },
    "cycle.calendar.phase_helper.ovulatory" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Often a phase associated with feeling more open, connected and outward-facing."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genellikle daha açık, daha bağlantıda ve dış dünyaya dönük hissedilebilen bir dönem."
