          "stringUnit" : {
            "state" : "translated",
            "value" : "When much of the day is spent meeting other people’s needs, noticing your own needs can become difficult."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günün büyük kısmı başkalarının ihtiyaçlarıyla geçtiğinde kendi ihtiyaçlarını fark etmek zorlaşabilir."
          }
        }
      }
    },
    "info.motherhood.making_space.hesia" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today’s meditation aims to create a space that belongs only to you for a few minutes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünkü meditasyon birkaç dakika boyunca yalnızca kendine ait bir alan oluşturmayı amaçlar."
          }
        }
      }
    },
    "info.motherhood.making_space.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Making space for yourself"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendine alan açmak"
          }
        }
      }
    },
    "info.motherhood.mental_load.accessibility" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About mental load"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zihinsel yük hakkında bilgi"
          }
        }
      }
    },
    "info.motherhood.mental_load.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Throughout the day, remembering and planning what needs to be done can consume mental energy alongside the tasks themselves."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gün boyunca yalnızca yaptığın işleri değil, yapılması gerekenleri hatırlamak ve planlamak da zihinsel enerji tüketebilir."
          }
        }
      }
    },
    "info.motherhood.mental_load.hesia" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today’s meditation creates space to set down your mental to-do list for a moment and return to the present."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünkü meditasyon zihnindeki yapılacakları kısa süreliğine bırakıp yalnızca bulunduğun ana dönmene alan açar."
          }
        }
      }
    },
    "info.motherhood.mental_load.highlight.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your mind may be constantly thinking about what needs to be done."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zihnin sürekli yapılacakları düşünüyor olabilir."
          }
        }
      }
    },
    "info.motherhood.mental_load.highlight.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even while resting, you may feel as if you are forgetting something."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinlenirken bile bir şey unutuyormuş gibi hissedebilirsin."
          }
        }
      }
    },
    "info.motherhood.mental_load.highlight.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even small decisions may feel tiring."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küçük kararlar bile yorucu gelebilir."
          }
        }
      }
    },
    "info.motherhood.mental_load.title" : {
