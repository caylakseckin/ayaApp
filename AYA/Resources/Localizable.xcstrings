    "cycle.onboarding.advisory.cycle_length.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For most adults, menstrual cycles are commonly 21–35 days. If your cycles are regularly outside this range, HESIA recommends speaking with a healthcare professional."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yetişkinlerde regl döngüsü çoğunlukla 21–35 gün arasındadır. Döngülerin düzenli olarak bu aralığın dışındaysa HESIA bir sağlık uzmanına danışmanı önerir."
          }
        }
      }
    },
    "cycle.onboarding.advisory.cycle_length.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your cycle is outside the common range"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döngün yaygın aralığın dışında"
          }
        }
      }
    },
    "cycle.onboarding.advisory.edit" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenle"
          }
        }
      }
    },
    "cycle.onboarding.advisory.last_period.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This date is more than 28 days ago. A late or missed period can have many causes, including pregnancy. Are you sure the date is correct? If pregnancy is possible or you are concerned about a health change, consider taking a test or speaking with a healthcare professional."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tarih 28 günden daha eski. Geciken veya atlanan regl, gebelik dahil birçok nedenle olabilir. Tarihin doğru olduğundan emin misin? Gebelik olasılığı veya sağlıkla ilgili bir endişen varsa test yapmayı ya da bir sağlık uzmanına danışmayı düşünebilirsin."
          }
        }
      }
    },
    "cycle.onboarding.advisory.last_period.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure about this date?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tarihten emin misin?"
          }
        }
      }
    },
    "cycle.onboarding.advisory.period_duration.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A menstrual period commonly lasts 2–7 days. If your periods are regularly shorter or longer, HESIA recommends speaking with a healthcare professional."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regl kanaması çoğunlukla 2–7 gün sürer. Regl süren düzenli olarak daha kısa veya daha uzunsa HESIA bir sağlık uzmanına danışmanı önerir."
          }
        }
      }
    },
    "cycle.onboarding.advisory.period_duration.title" : {
