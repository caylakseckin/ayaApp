        }
      }
    },
    "info.motherhood.fatigue.hesia" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today’s meditation does not ask for more energy; it accompanies you in pausing and breathing where you are."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünkü meditasyon senden daha fazla enerji istemek yerine olduğun yerde durmana ve nefes almana eşlik eder."
          }
        }
      }
    },
