      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alongside physical rest, giving constant attention and carrying responsibility can also be tiring."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiziksel dinlenmenin yanında sürekli dikkat vermek ve sorumluluk taşımak da yorucu olabilir."
