    "info.postpartum.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After birth, your body may be healing while your hormones, sleep, and daily rhythm also change quickly."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğumdan sonraki dönemde bedenin iyileşirken hormonların, uykun ve günlük düzenin de hızlı şekilde değişebilir."
          }
        }
      }
    },
    "info.postpartum.disclaimer" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This content is for general information and does not replace professional healthcare assessment."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu içerik genel bilgilendirme amaçlıdır ve profesyonel sağlık değerlendirmesinin yerini tutmaz."
          }
        }
      }
    },
    "info.postpartum.hesia" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meditations during this period focus not on performing, but on resting, breathing, and making small spaces for yourself."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dönemde meditasyonların performans göstermeye değil, dinlenmeye, nefes almaya ve kendine küçük alanlar açmaya odaklanır."
          }
        }
      }
    },
    "info.postpartum.highlight.1" : {
      "extractionState" : "stale",
